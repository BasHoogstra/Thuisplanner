{
  "name": "thuisplanner-app",
  "private": true,
  "version": "0.2.0",
  "description": "Thuisplanner KG-2: klikbaar prototype van het Vandaag-scherm, met fictieve voorbeeldgegevens en zonder backend.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:staging": "node scripts/staging-kenmerk.mjs && tsc --noEmit && vite build --mode staging",
    "preview": "vite preview",
    "losbestand": "tsc --noEmit && vite build && node scripts/losbestand.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "screenshots": "KG_SCREENSHOTS=1 playwright test --grep @screenshot",
    "lokaal": "node scripts/lokaal.mjs dev",
    "lokaal:lan": "node scripts/lokaal.mjs dev --lan",
    "lokaal:seed": "node scripts/lokaal.mjs seed",
    "e2e:staging": "playwright test -c playwright.staging.config.ts",
    "e2e:lokaal": "playwright test -c playwright.lokaal.config.ts",
    "screenshots:lokaal": "KG_SCREENSHOTS=1 playwright test -c playwright.lokaal.config.ts --grep @screenshot",
    "lan-proef": "bash scripts/lan-proef.sh",
    "e2e:website": "playwright test -c playwright.website.config.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.18.8",
    "@types/react": "19.1.17",
    "@types/react-dom": "19.1.11",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "typescript": "5.9.3",
    "vite": "7.1.12",
    "vitest": "3.2.4"
  }
}
